{
  "expo": {
    "name": "Süper Lig Scout & Analiz",
    "slug": "superlig-scout-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.superlig.scout"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070a12"
      },
      "package": "com.superlig.scout"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "defaultApiUrl": "https://chose-increasingly-robbie-drug.trycloudflare.com/api"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#070a12",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
