# Django Ayarları
DEBUG=True
SECRET_KEY=your-secret-key-here

# Veritabanı Seçimi:
# PostgreSQL aktif etmek için USE_SQLITE=false yapın
USE_SQLITE=false

# PostgreSQL Ayarları
DB_ENGINE=postgresql
DB_NAME=superlig_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# RapidAPI (API-Football) Ayarları (Opsiyonel)
RAPIDAPI_KEY=your_rapidapi_football_key_here

